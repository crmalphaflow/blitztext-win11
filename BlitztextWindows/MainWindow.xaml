<Window x:Class="BlitztextWindows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Blitztext" Height="700" Width="860" MinHeight="640" MinWidth="760"
        Background="#EEF2F7" Closing="Window_Closing" FontFamily="Segoe UI"
        Icon="Resources/Blitztext.ico">
    <Window.Resources>
        <SolidColorBrush x:Key="InkBrush" Color="#111827"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#64748B"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="LineBrush" Color="#D7DEE9"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#2563EB"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#1D4ED8"/>
        <SolidColorBrush x:Key="SoftAccentBrush" Color="#EAF2FF"/>

        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#172033"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#D7DEE9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#EDF3FB"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#B8C7DD"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#DCE8F7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#1E40AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WorkflowButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="13,9"/>
            <Setter Property="Background" Value="#F8FAFC"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="BorderBrush" Value="#D7DEE9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FBFCFE"/>
            <Setter Property="Foreground" Value="#172033"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="BorderBrush" Value="#D7DEE9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FBFCFE"/>
            <Setter Property="Foreground" Value="#172033"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#101827" Padding="24,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Blitztext" Foreground="White" FontSize="30" FontWeight="SemiBold"/>
                    <TextBlock Text="Sprache aufnehmen, umwandeln und direkt einfuegen." Foreground="#B7C4D8" FontSize="13" Margin="1,5,0,0"/>
                </StackPanel>
                <Border x:Name="StatusBorder" Grid.Column="1" Background="#EAF2FF" BorderBrush="#BBD2F6"
                        BorderThickness="1" CornerRadius="6" Padding="12,7" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" Foreground="#25456F" FontSize="13" FontWeight="SemiBold" Text="Bereit"/>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="16" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="OpenAI Verbindung" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" FontSize="15"/>
                        <TextBlock x:Name="KeyHintText" Margin="1,4,0,0" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                        <Button x:Name="ToggleApiKeyButton" Content="API Key aendern" Click="ToggleApiKey_Click" Margin="0,0,8,0"/>
                        <Button Content="Loeschen" Click="DeleteApiKey_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="ApiKeyEditor" Grid.Row="0" Margin="0,76,0,0" Padding="16"
                    Background="#FBFCFE" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="API Key eintragen" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" FontSize="13"/>
                        <PasswordBox x:Name="ApiKeyBox" Margin="0,8,0,0" MinWidth="420" PasswordChar="*"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="16,0,0,0">
                        <Button Content="Speichern" Click="SaveApiKey_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                        <Button Content="Abbrechen" Click="CancelApiKey_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Padding="18" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Workflows" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" FontSize="16" Margin="0,0,0,12"/>
                            <Button x:Name="Mode1Button" Content="1  Direkt transkribieren" Tag="Transcribe" Click="Workflow_Click" Style="{StaticResource WorkflowButton}"/>
                            <Button x:Name="Mode2Button" Content="2  Professionelle E-Mail" Tag="Improve" Click="Workflow_Click" Style="{StaticResource WorkflowButton}"/>
                            <Button x:Name="Mode3Button" Content="3  Social-Media-Post" Tag="Calm" Click="Workflow_Click" Style="{StaticResource WorkflowButton}" Margin="0,0,0,18"/>

                            <Border Height="1" Background="#E5EAF1" Margin="0,2,0,16"/>

                            <TextBlock Text="Razer-Tasten" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" FontSize="16" Margin="0,0,0,4"/>
                            <TextBlock Text="Taste lernen, danach funktioniert sie global im Hintergrund." Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"/>

                            <Grid Margin="0,0,0,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TranscribeHotkeyText" VerticalAlignment="Center" Foreground="#334155" FontSize="12"/>
                                <Button Grid.Column="1" Content="Lernen" Tag="Transcribe" Click="LearnHotkey_Click" Padding="9,5"/>
                            </Grid>
                            <Grid Margin="0,0,0,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ImproveHotkeyText" VerticalAlignment="Center" Foreground="#334155" FontSize="12"/>
                                <Button Grid.Column="1" Content="Lernen" Tag="Improve" Click="LearnHotkey_Click" Padding="9,5"/>
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="CalmHotkeyText" VerticalAlignment="Center" Foreground="#334155" FontSize="12"/>
                                <Button Grid.Column="1" Content="Lernen" Tag="Calm" Click="LearnHotkey_Click" Padding="9,5"/>
                            </Grid>
                            <Button Content="Standard wiederherstellen" Click="ResetHotkeys_Click" Margin="0,0,0,12"/>
                            <TextBlock Text="Fallbacks: NumPad1-3, F13-F15 und Ctrl-Shortcuts bleiben aktiv."
                                       Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,16"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="GhostHotkeyText" VerticalAlignment="Center" Foreground="#334155" FontSize="12"/>
                                <Button Grid.Column="1" Content="Lernen" Tag="Ghost" Click="LearnHotkey_Click" Padding="9,5"/>
                            </Grid>
                            <Button Content="Ghost-Modus umschalten" Click="ToggleGhost_Click" Margin="0,0,0,16"/>

                            <Border Height="1" Background="#E5EAF1" Margin="0,2,0,16"/>

                            <TextBlock Text="Modi anpassen" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" FontSize="16" Margin="0,0,0,8"/>
                            <ComboBox x:Name="ModeEditorCombo" SelectionChanged="ModeEditorCombo_SelectionChanged" Margin="0,0,0,8"/>
                            <TextBlock Text="Name" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                            <TextBox x:Name="ModeNameBox" TextChanged="ModeEditor_TextChanged" Margin="0,4,0,8" Padding="8,6"/>
                            <TextBlock Text="Sprache" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                            <TextBox x:Name="ModeLanguageBox" TextChanged="ModeEditor_TextChanged" Margin="0,4,0,8" Padding="8,6"/>
                            <TextBlock Text="Prompt" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                            <TextBox x:Name="ModePromptBox" TextChanged="ModeEditor_TextChanged" Margin="0,4,0,8"
                                     MinHeight="110" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="8"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Kreativitaet" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ModeTemperatureText" Grid.Column="1" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                            </Grid>
                            <Slider x:Name="ModeTemperatureSlider" Minimum="0" Maximum="1" TickFrequency="0.05"
                                    ValueChanged="ModeTemperatureSlider_ValueChanged" Margin="0,0,0,8"/>
                            <CheckBox x:Name="ModeAutoPasteBox" Content="Diesen Modus automatisch einfuegen"
                                      Checked="ModeEditor_CheckChanged" Unchecked="ModeEditor_CheckChanged"
                                      Foreground="#334155" Margin="0,0,0,8"/>
                            <Button Content="Modi auf Standard setzen" Click="ResetModes_Click" Margin="0,0,0,16"/>

                            <Border Height="1" Background="#E5EAF1" Margin="0,2,0,16"/>

                            <TextBlock Text="App" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" FontSize="16" Margin="0,0,0,8"/>
                            <CheckBox x:Name="SoundEnabledBox" Content="Toene fuer Start, Fertig und Fehler"
                                      Checked="SoundEnabledBox_Changed" Unchecked="SoundEnabledBox_Changed"
                                      Foreground="#334155" Margin="0,0,0,8"/>
                            <CheckBox x:Name="StartWithWindowsBox" Content="Mit Windows starten"
                                      Checked="StartWithWindowsBox_Changed" Unchecked="StartWithWindowsBox_Changed"
                                      Foreground="#334155" Margin="0,0,0,8"/>
                            <CheckBox x:Name="StartInGhostModeBox" Content="Beim Start nur Mini-Mikro zeigen"
                                      Checked="StartInGhostModeBox_Changed" Unchecked="StartInGhostModeBox_Changed"
                                      Foreground="#334155"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <Border Grid.Column="1" Margin="18,0,0,0" Padding="18" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <StackPanel>
                                <TextBlock Text="Ausgabe" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" FontSize="16"/>
                                <TextBlock Text="Rohtext und fertiger Text bleiben hier sichtbar." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Button DockPanel.Dock="Right" Content="Kopieren" Click="CopyOutput_Click" Padding="12,7" VerticalAlignment="Top"/>
                        </DockPanel>
                        <TabControl x:Name="ResultsTabs" Grid.Row="1" Margin="0,14,0,14">
                            <TabItem Header="Ergebnis">
                                <TextBox x:Name="OutputBox" AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" FontSize="14"/>
                            </TabItem>
                            <TabItem Header="Rohtext">
                                <TextBox x:Name="RawTranscriptBox" AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" FontSize="14"/>
                            </TabItem>
                        </TabControl>
                        <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E5EAF1" BorderThickness="1" CornerRadius="6" Padding="12,9">
                            <TextBlock x:Name="PasteModeText" Foreground="#334155" TextWrapping="Wrap" FontSize="12"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

    </Grid>
</Window>
